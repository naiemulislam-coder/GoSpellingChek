<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SingUpActivity"
    android:orientation="vertical"
    android:background="@drawable/sing"
    >

    <TextView
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Welcome To SingUp"
        android:layout_marginTop="230dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#FFC107"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_marginTop="14dp"
        android:layout_width="300dp"
        android:layout_height="60dp"
        app:startIconDrawable="@drawable/outline_person_24"
        android:layout_gravity="center"
        app:helperText="Plies Enter"
        app:helperTextTextColor="@color/design_default_color_error"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Enter Your Name"
            android:textSize="15sp"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_marginTop="6dp"
        android:layout_width="300dp"
        android:layout_height="60dp"
        app:startIconDrawable="@drawable/baseline_email_24"
        android:layout_gravity="center"
        app:helperText="Plies Enter"
        app:helperTextTextColor="@color/design_default_color_error"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Enter Your Email"
            android:textSize="15sp"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_marginTop="6dp"
        android:layout_width="300dp"
        android:layout_height="60dp"
        app:startIconDrawable="@drawable/outline_lock_24"
        android:layout_gravity="center"
        app:helperText="Plies Enter"
        app:endIconMode="password_toggle"
        app:helperTextTextColor="@color/design_default_color_error"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Enter Your Password"
            android:textSize="15sp"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_marginTop="6dp"
        android:layout_width="300dp"
        android:layout_height="60dp"
        app:startIconDrawable="@drawable/outline_person_24"
        android:layout_gravity="center"
        app:helperText="Plies Enter"
        app:helperTextTextColor="@color/design_default_color_error"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Enter Your user Name"
            android:textSize="15sp"
            />

    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnSing"
        android:layout_marginTop="12dp"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="SingUp"
        android:textSize="20sp"
        android:backgroundTint="@android:color/holo_green_dark"
        android:layout_gravity="center"
        />

    <TextView
        android:id="@+id/etNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hav An a Account? / Login"
        android:textSize="16sp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:textColor="@android:color/black"
        />

</LinearLayout>